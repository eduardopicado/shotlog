{
  "name": "shotlog",
  "version": "0.1.0",
  "private": true,
  "description": "Personal coffee journal and espresso dial-in assistant",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardopicado/shotlog.git"
  },
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && concurrently -k -n api,web \"wrangler dev --port 8787\" \"vite\"",
    "build": "vite build",
    "preview": "npm run build && npm run db:migrate:local && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply shotlog --local",
    "db:migrate:remote": "wrangler d1 migrations apply shotlog --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --strict-vars=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "hono": "^4.13.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
